import React, { useState, useEffect, useRef } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, collection, addDoc, onSnapshot, serverTimestamp, doc, updateDoc } from 'firebase/firestore';
import { 
  Upload, FileText, BookOpen, Bookmark, Library, FileSearch, 
  CheckCircle, AlertCircle, Loader2, File, ChevronRight, X, Sparkles, Send, Save
} from 'lucide-react';

const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

const GEMINI_API_KEY = ""; // Provided by environment runtime
const GEMINI_API_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${GEMINI_API_KEY}`;

const DOC_TYPES = {
  JURNAL: 'Artikel Jurnal',
  BUKU: 'Buku',
  CHAPTER: 'Chapter Buku'
};

const schemas = {
  [DOC_TYPES.JURNAL]: {
    type: "OBJECT",
    properties: {
      judulArtikel: { type: "STRING", description: "Judul dari artikel jurnal" },
      namaPenulis: { type: "STRING", description: "Nama penulis artikel" },
      kataKunci: { type: "STRING", description: "Kata kunci atau keywords" },
      penerbit: { type: "STRING", description: "Penerbit jurnal" },
      volume: { type: "STRING", description: "Volume jurnal" },
      issue: { type: "STRING", description: "Issue atau nomor jurnal" },
      tahun: { type: "STRING", description: "Tahun terbit" },
      abstrak: { type: "STRING", description: "Ringkasan abstrak" },
      introduction: { type: "STRING", description: "Menjelaskan latar belakang, rumusan masalah, celah penelitian (research gap), serta tujuan dan kontribusi dari penelitian yang dilakukan." },
      methods: { type: "STRING", description: "Menggambarkan pendekatan, sumber data, alat, dan tahapan penelitian secara detail agar studi dapat direplikasi oleh peneliti lain." },
      results: { type: "STRING", description: "Menyajikan data dan temuan utama secara objektif dan apa adanya, sering kali didukung dengan tabel atau grafik." },
      discussion: { type: "STRING", description: "Menafsirkan makna temuan, menghubungkannya dengan teori atau studi sebelumnya, serta memaparkan keterbatasan penelitian." },
      objek: { type: "STRING", description: "Objek penelitian" },
      teori: { type: "STRING", description: "Teori yang digunakan" },
      metodologi: { type: "STRING", description: "Metodologi penelitian" }
    }
  },
  [DOC_TYPES.BUKU]: {
    type: "OBJECT",
    properties: {
      judulBuku: { type: "STRING", description: "Judul buku lengkap" },
      namaPenulis: { type: "STRING", description: "Nama pengarang/penulis/penerjemah" },
      penerbit: { type: "STRING", description: "Nama penerbit" },
      tahun: { type: "STRING", description: "Tahun terbit" },
      tempatTerbit: { type: "STRING", description: "Tempat atau kota terbit" },
      cetakan: { type: "STRING", description: "Cetakan atau jilid ke berapa" }
    }
  },
  [DOC_TYPES.CHAPTER]: {
    type: "OBJECT",
    properties: {
      judulChapter: { type: "STRING", description: "Judul chapter atau bab" },
      namaPenulis: { type: "STRING", description: "Nama penulis chapter tersebut" },
      judulBuku: { type: "STRING", description: "Judul buku utama" },
      halaman: { type: "STRING", description: "Rentang halaman (contoh: 24-45)" }
    }
  }
};

// Urutan baku (paten) untuk tampilan hasil ekstraksi
const DISPLAY_ORDER = {
  [DOC_TYPES.JURNAL]: [
    'judulArtikel', 'namaPenulis', 'kataKunci', 'penerbit', 'volume', 
    'issue', 'tahun', 'abstrak', 'introduction', 'methods', 
    'results', 'discussion', 'objek', 'teori', 'metodologi'
  ],
  [DOC_TYPES.BUKU]: [
    'judulBuku', 'namaPenulis', 'penerbit', 'tahun', 'tempatTerbit', 'cetakan'
  ],
  [DOC_TYPES.CHAPTER]: [
    'judulChapter', 'namaPenulis', 'judulBuku', 'halaman'
  ]
};

export default function App() {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('upload'); 
  const [archives, setArchives] = useState([]);
  const [selectedArchive, setSelectedArchive] = useState(null);
  
  const [file, setFile] = useState(null);
  const [docType, setDocType] = useState(DOC_TYPES.JURNAL);
  const [isProcessing, setIsProcessing] = useState(false);
  const [processStatus, setProcessStatus] = useState('');
  const [errorMsg, setErrorMsg] = useState('');
  const [extractedData, setExtractedData] = useState(null);

  const [isEditingArchive, setIsEditingArchive] = useState(false);
  const [editedArchiveData, setEditedArchiveData] = useState(null);

  const [aiQuestion, setAiQuestion] = useState('');
  const [aiAnswer, setAiAnswer] = useState('');
  const [isAiLoading, setIsAiLoading] = useState(false);

  const [filterType, setFilterType] = useState('Semua');

  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth error:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  useEffect(() => {
    if (!user) return;
    
    const archivesRef = collection(db, 'artifacts', appId, 'users', user.uid, 'annotations');
    const unsubscribe = onSnapshot(archivesRef, (snapshot) => {
      const data = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      data.sort((a, b) => {
        const timeA = a.createdAt?.toMillis() || 0;
        const timeB = b.createdAt?.toMillis() || 0;
        return timeB - timeA;
      });
      setArchives(data);
    }, (error) => {
      console.error("Firestore error:", error);
    });

    return () => unsubscribe();
  }, [user]);

  const resetAiState = () => {
    setAiQuestion('');
    setAiAnswer('');
    setIsAiLoading(false);
  };

  const handleFileChange = (e) => {
    const selectedFile = e.target.files[0];
    if (selectedFile && selectedFile.type === 'application/pdf') {
      setFile(selectedFile);
      setErrorMsg('');
      setExtractedData(null);
      resetAiState();
    } else {
      setErrorMsg('Mohon unggah file dengan format PDF.');
      setFile(null);
    }
  };

  const processDocument = async () => {
    if (!file) {
      setErrorMsg('Pilih file PDF terlebih dahulu.');
      return;
    }

    setIsProcessing(true);
    setErrorMsg('');
    setProcessStatus('Membaca file PDF...');

    try {
      const base64Data = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => resolve(reader.result.split(',')[1]);
        reader.onerror = error => reject(error);
      });

      setProcessStatus('Menganalisis dokumen dengan AI...');

      const payload = {
        contents: [{
          role: "user",
          parts: [
            { text: `Tolong baca dokumen PDF yang dilampirkan ini dan ekstrak informasi bibliografi yang diperlukan sesuai dengan skema JSON yang diminta untuk jenis dokumen: ${docType}. Ekstrak dokumen dengan tingkat akurasi tinggi dalam Bahasa Indonesia tetapi khusus untuk judul dari dokumen sesuai dengan bahasa yang digunakan. Jika ada informasi yang tidak ditemukan, kosongkan atau tulis "Tidak disebutkan".` },
            { inlineData: { mimeType: "application/pdf", data: base64Data } }
          ]
        }],
        systemInstruction: {
          parts: [{ text: "Anda adalah seorang profesor yang telah melakukan berbagai macam penelitian dan ahli ekstraksi data bibliografi." }]
        },
        generationConfig: {
          responseMimeType: "application/json",
          responseSchema: schemas[docType]
        }
      };

      const response = await fetch(GEMINI_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();
      
      if (result.candidates && result.candidates[0]?.content?.parts?.[0]?.text) {
        const jsonText = result.candidates[0].content.parts[0].text;
        const parsedData = JSON.parse(jsonText);
        setExtractedData(parsedData);
      } else {
        throw new Error("Gagal mengekstrak data atau dokumen terlalu besar/kompleks.");
      }
      
    } catch (err) {
      console.error(err);
      setErrorMsg('Terjadi kesalahan saat memproses dokumen: ' + (err.message || 'Error tidak diketahui.'));
    } finally {
      setIsProcessing(false);
      setProcessStatus('');
    }
  };

  const handleSaveAnnotation = async () => {
    if (!user || !extractedData) return;
    
    setIsProcessing(true);
    setProcessStatus('Menyimpan anotasi...');
    
    try {
      const archivesRef = collection(db, 'artifacts', appId, 'users', user.uid, 'annotations');
      await addDoc(archivesRef, {
        type: docType,
        fileName: file.name,
        data: extractedData,
        createdAt: serverTimestamp()
      });
      
      setFile(null);
      setExtractedData(null);
      resetAiState();
      setActiveTab('archive');
    } catch (err) {
      console.error("Save error:", err);
      setErrorMsg('Gagal menyimpan anotasi.');
    } finally {
      setIsProcessing(false);
      setProcessStatus('');
    }
  };

  const handleUpdateArchive = async () => {
    if (!user || !selectedArchive || !editedArchiveData) return;
    
    setIsProcessing(true);
    setProcessStatus('Memperbarui arsip...');
    
    try {
      const archiveRef = doc(db, 'artifacts', appId, 'users', user.uid, 'annotations', selectedArchive.id);
      await updateDoc(archiveRef, {
        data: editedArchiveData
      });
      
      // Update data di UI secara instan
      setSelectedArchive({ ...selectedArchive, data: editedArchiveData });
      setIsEditingArchive(false);
    } catch (err) {
      console.error("Update error:", err);
      setErrorMsg('Gagal memperbarui arsip.');
    } finally {
      setIsProcessing(false);
      setProcessStatus('');
    }
  };

  const handleAskAI = async (contextData, presetQuestion = null) => {
    const question = presetQuestion || aiQuestion;
    if (!question.trim()) return;

    setIsAiLoading(true);
    setAiAnswer('');
    if (presetQuestion) setAiQuestion(presetQuestion);

    try {
      const promptText = `Berdasarkan informasi bibliografi dan ringkasan dokumen berikut:\n\n${JSON.stringify(contextData, null, 2)}\n\nPertanyaan pengguna: ${question}\n\nJika informasi yang ditanyakan tidak terdapat dalam data di atas, mohon sampaikan bahwa informasi tersebut tidak tersedia di dokumen.`;

      const payload = {
        contents: [{ parts: [{ text: promptText }] }],
        systemInstruction: {
          parts: [{ text: "Anda adalah asisten peneliti ahli. Tolong jawab dalam Bahasa Indonesia yang akademis, profesional, namun mudah dipahami." }]
        }
      };

      const response = await fetch(GEMINI_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();
      if (result.candidates && result.candidates[0]?.content?.parts?.[0]?.text) {
        setAiAnswer(result.candidates[0].content.parts[0].text);
      } else {
        setAiAnswer("Maaf, AI tidak dapat menghasilkan respons saat ini.");
      }
    } catch (err) {
      console.error("AI Error:", err);
      setAiAnswer("Terjadi kesalahan jaringan saat menghubungi AI.");
    } finally {
      setIsAiLoading(false);
    }
  };

  const renderAiAssistant = (contextData) => {
    return (
      <div className="mt-8 p-5 bg-gradient-to-br from-indigo-50 to-purple-50 rounded-xl border border-indigo-100 shadow-inner">
        <h3 className="text-md font-bold text-indigo-900 flex items-center gap-2 mb-3">
          <Sparkles size={18} className="text-indigo-600"/> Asisten AI (Tanya Dokumen)
        </h3>
        <p className="text-xs text-indigo-700 mb-4">Ajukan pertanyaan berdasarkan hasil ekstraksi dokumen ini, atau gunakan pertanyaan instan.</p>
        
        <div className="flex flex-wrap gap-2 mb-4">
           <button 
             onClick={() => handleAskAI(contextData, "Tolong ringkas dokumen ini dalam 3 kalimat sederhana untuk orang awam.")} 
             className="px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 text-xs font-semibold rounded-full shadow-sm hover:bg-indigo-50 transition-colors"
           >
             Buat Ringkasan Singkat
           </button>
           <button 
             onClick={() => handleAskAI(contextData, "Apa metode utama yang digunakan dan apa hasil paling penting dari penelitian ini?")} 
             className="px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 text-xs font-semibold rounded-full shadow-sm hover:bg-indigo-50 transition-colors"
           >
             Metode & Hasil Utama
           </button>
           <button 
             onClick={() => handleAskAI(contextData, "Apakah ada kelemahan atau saran penelitian lanjutan yang disebutkan?")} 
             className="px-3 py-1.5 bg-white border border-indigo-200 text-indigo-700 text-xs font-semibold rounded-full shadow-sm hover:bg-indigo-50 transition-colors"
           >
             Cari Limitasi/Saran
           </button>
           <button 
             onClick={() => handleAskAI(contextData, "Buatkan satu paragraf sintesis/kajian pustaka yang koheren berdasarkan dokumen ini, yang siap dimasukkan ke dalam bab Tinjauan Pustaka. Mulai langsung dengan paragrafnya tanpa basa-basi.")} 
             className="px-3 py-1.5 bg-gradient-to-r from-purple-500 to-indigo-600 text-white border border-transparent text-xs font-semibold rounded-full shadow-sm hover:from-purple-600 hover:to-indigo-700 transition-all"
           >
             Tulis Paragraf Kajian Pustaka
           </button>
        </div>

        <div className="flex gap-2">
          <input 
            type="text"
            value={aiQuestion} 
            onChange={(e) => setAiQuestion(e.target.value)} 
            onKeyDown={(e) => e.key === 'Enter' && handleAskAI(contextData)}
            placeholder="Tanyakan sesuatu tentang dokumen ini..." 
            className="flex-1 p-2.5 rounded-lg border border-indigo-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm"
          />
          <button 
            onClick={() => handleAskAI(contextData)} 
            disabled={isAiLoading || !aiQuestion.trim()} 
            className="bg-indigo-600 text-white p-2.5 rounded-lg font-semibold shadow-sm hover:bg-indigo-700 disabled:bg-indigo-300 transition-all flex items-center justify-center min-w-[3rem]"
          >
            {isAiLoading ? <Loader2 size={18} className="animate-spin" /> : <Send size={18} />}
          </button>
        </div>

        {aiAnswer && (
          <div className="mt-4 p-4 bg-white rounded-lg border border-indigo-100 shadow-sm animate-in fade-in slide-in-from-top-2 duration-300">
            <div className="flex items-start gap-3">
               <Sparkles size={18} className="text-purple-500 mt-0.5 shrink-0"/>
               <div className="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap">
                 {aiAnswer}
               </div>
            </div>
          </div>
        )}
      </div>
    );
  };

  const renderField = (key, value, isEditing = false, onChange = null) => {
    const label = key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase());
    const strValue = typeof value === 'string' ? value : String(value || '');
    
    // Fleksibel: Menentukan apakah field butuh ruang lebar (berdasarkan daftar kunci atau jika AI menghasilkan teks > 120 karakter)
    const isLongField = [
      'abstrak', 'introduction', 'methods', 'results', 'discussion', 
      'teori', 'metodologi', 'objek', 'judulArtikel', 'judulBuku', 'judulChapter'
    ].includes(key) || strValue.length > 120;
    
    if (isEditing) {
      return (
        <div key={key} className={`mb-2 ${isLongField ? 'md:col-span-2' : 'md:col-span-1'}`}>
          <label className="block text-sm font-semibold text-gray-700 mb-1">{label}</label>
          {isLongField ? (
            <textarea 
              value={value || ''} 
              onChange={(e) => onChange(key, e.target.value)}
              className="w-full p-2.5 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 min-h-[6rem] text-sm outline-none resize-y"
            />
          ) : (
            <input 
              type="text"
              value={value || ''} 
              onChange={(e) => onChange(key, e.target.value)}
              className="w-full p-2.5 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 text-sm outline-none"
            />
          )}
        </div>
      );
    }

    return (
      <div key={key} className={`mb-2 border-b border-gray-100 pb-3 last:border-0 ${isLongField ? 'md:col-span-2' : 'md:col-span-1'}`}>
        <span className="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">{label}</span>
        <p className="text-gray-800 text-sm whitespace-pre-wrap leading-relaxed">{value || <span className="text-gray-400 italic">Tidak ditemukan</span>}</p>
      </div>
    );
  };

  return (
    <div className="min-h-screen bg-gray-50 flex flex-col font-sans">
      {/* Navbar */}
      <header className="bg-white shadow-sm sticky top-0 z-10">
        <div className="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
          <div className="flex items-center gap-2 text-indigo-700">
            <BookOpen size={28} className="text-indigo-600" />
            <h1 className="text-xl font-bold tracking-tight">Anotasi Bibliografi</h1>
          </div>
          <nav className="flex gap-1 bg-gray-100 p-1 rounded-lg">
            <button 
              onClick={() => { setActiveTab('upload'); resetAiState(); }}
              className={`px-4 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2 ${activeTab === 'upload' ? 'bg-white shadow text-indigo-700' : 'text-gray-600 hover:text-gray-900'}`}
            >
              <Upload size={16} /> Unggah Baru
            </button>
            <button 
              onClick={() => { setActiveTab('archive'); resetAiState(); }}
              className={`px-4 py-2 rounded-md text-sm font-medium transition-colors flex items-center gap-2 ${activeTab === 'archive' ? 'bg-white shadow text-indigo-700' : 'text-gray-600 hover:text-gray-900'}`}
            >
              <Library size={16} /> Arsip Dokumen
            </button>
          </nav>
        </div>
      </header>

      {/* Main Content Area */}
      <main className="flex-1 max-w-6xl mx-auto w-full p-4 py-8">
        
        {/* TAB: UPLOAD */}
        {activeTab === 'upload' && (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            {/* Upload Sidebar */}
            <div className="lg:col-span-4 flex flex-col gap-4">
              <div className="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                <h2 className="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                  <FileText size={20} className="text-indigo-500"/> Detail Dokumen
                </h2>
                
                <div className="mb-4">
                  <label className="block text-sm font-medium text-gray-700 mb-2">Pilih Tipe Dokumen</label>
                  <select 
                    value={docType}
                    onChange={(e) => setDocType(e.target.value)}
                    className="w-full p-2.5 border border-gray-300 rounded-lg bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all outline-none text-sm"
                  >
                    {Object.values(DOC_TYPES).map(type => (
                      <option key={type} value={type}>{type}</option>
                    ))}
                  </select>
                </div>

                <div className="mb-6">
                  <label className="block text-sm font-medium text-gray-700 mb-2">Unggah File PDF</label>
                  <div className="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg bg-gray-50 hover:bg-gray-100 transition-colors relative">
                    <div className="space-y-1 text-center">
                      <FileSearch className="mx-auto h-10 w-10 text-gray-400" />
                      <div className="flex text-sm text-gray-600 justify-center">
                        <label className="relative cursor-pointer rounded-md font-medium text-indigo-600 hover:text-indigo-500 focus-within:outline-none">
                          <span>Cari file PDF</span>
                          <input type="file" accept="application/pdf" className="sr-only" onChange={handleFileChange} />
                        </label>
                      </div>
                      <p className="text-xs text-gray-500">Maks. 10MB (PDF saja)</p>
                    </div>
                  </div>
                  {file && (
                    <div className="mt-3 flex items-center gap-2 text-sm text-green-700 bg-green-50 p-2 rounded-md border border-green-100">
                      <CheckCircle size={16} className="shrink-0" />
                      <span className="truncate flex-1" title={file.name}>{file.name}</span>
                      <button onClick={() => {setFile(null); setExtractedData(null);}} className="text-gray-500 hover:text-red-500 shrink-0">
                        <X size={16} />
                      </button>
                    </div>
                  )}
                </div>

                {errorMsg && (
                  <div className="mb-4 p-3 bg-red-50 text-red-700 rounded-md text-sm flex items-start gap-2">
                    <AlertCircle size={16} className="mt-0.5 shrink-0" />
                    <span>{errorMsg}</span>
                  </div>
                )}

                <button 
                  onClick={processDocument}
                  disabled={!file || isProcessing}
                  className="w-full bg-indigo-600 text-white p-3 rounded-lg font-semibold shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:bg-gray-400 disabled:cursor-not-allowed transition-all flex justify-center items-center gap-2"
                >
                  {isProcessing && !extractedData ? <Loader2 size={18} className="animate-spin" /> : <CheckCircle size={18} />}
                  {isProcessing && !extractedData ? processStatus : 'Mulai Ekstrak Data'}
                </button>
              </div>
            </div>

            {/* Extracted Data Preview Area */}
            <div className="lg:col-span-8">
              <div className="bg-white p-6 md:p-8 rounded-xl shadow-sm border border-gray-100 min-h-[500px]">
                {!extractedData && !isProcessing && (
                  <div className="h-full flex flex-col items-center justify-center text-gray-400 py-20">
                    <Bookmark size={48} className="mb-4 opacity-30" />
                    <h3 className="text-lg font-medium text-gray-600">Belum Ada Data</h3>
                    <p className="text-sm mt-2 text-center">Unggah file PDF dan klik "Mulai Ekstrak Data" untuk melihat hasil anotasi di sini secara berurutan.</p>
                  </div>
                )}

                {isProcessing && !extractedData && (
                  <div className="h-full flex flex-col items-center justify-center text-indigo-500 py-20">
                    <Loader2 size={48} className="animate-spin mb-4" />
                    <h3 className="text-lg font-medium text-gray-800">{processStatus}</h3>
                    <p className="text-sm text-gray-500 mt-2 text-center max-w-sm">Proses ini memakan waktu beberapa detik tergantung ukuran dokumen.</p>
                  </div>
                )}

                {}
                {extractedData && (
                  <div className="animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <div className="flex justify-between items-center mb-6 pb-4 border-b border-gray-200">
                      <div>
                        <h2 className="text-xl font-bold text-gray-800">Hasil Ekstraksi</h2>
                        <p className="text-sm text-gray-500">Tinjau dan edit hasil sebelum menyimpan ke arsip.</p>
                      </div>
                      <span className="px-3 py-1 bg-indigo-100 text-indigo-800 text-xs font-bold rounded-full">{docType}</span>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                      {DISPLAY_ORDER[docType].map(key => 
                        renderField(key, extractedData[key], true, (k, v) => setExtractedData({...extractedData, [k]: v}))
                      )}
                    </div>
                    
                    <div className="mt-8 pt-6 border-t border-gray-200 flex justify-end">
                      <button 
                        onClick={handleSaveAnnotation}
                        disabled={isProcessing}
                        className="bg-indigo-600 text-white px-6 py-2.5 rounded-lg font-semibold shadow-sm hover:bg-indigo-700 transition-all flex items-center gap-2 disabled:bg-indigo-400"
                      >
                        {isProcessing ? <Loader2 size={18} className="animate-spin" /> : <Save size={18} />}
                        {isProcessing ? 'Menyimpan...' : 'Simpan ke Arsip'}
                      </button>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* TAB: ARSIP DOKUMEN */}
        {activeTab === 'archive' && (
          <div className="space-y-6">
            <div className="flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
              <div>
                <h2 className="text-2xl font-bold text-gray-900 flex items-center gap-2">
                  <Library className="text-indigo-600"/> Arsip Dokumen Anda
                </h2>
                <p className="text-gray-500 text-sm mt-1">Daftar semua dokumen yang telah dianotasi (tersimpan di Database).</p>
              </div>
              
              {}
              <div className="flex items-center gap-2 bg-white p-1.5 rounded-lg border border-gray-200 shadow-sm">
                <span className="text-sm font-medium text-gray-600 px-2">Tampilkan:</span>
                <select 
                  value={filterType}
                  onChange={(e) => setFilterType(e.target.value)}
                  className="p-1.5 border border-transparent hover:border-gray-300 rounded-md text-sm bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none transition-all cursor-pointer font-medium text-indigo-700"
                >
                  <option value="Semua">Semua Dokumen</option>
                  {Object.values(DOC_TYPES).map(type => (
                    <option key={type} value={type}>{type}</option>
                  ))}
                </select>
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {archives.filter(item => filterType === 'Semua' || item.type === filterType).length === 0 ? (
                 <div className="col-span-full py-20 text-center bg-white rounded-xl border border-gray-100 shadow-sm">
                   <Library size={48} className="mx-auto text-gray-300 mb-4" />
                   <h3 className="text-lg font-medium text-gray-600">Arsip Tidak Ditemukan</h3>
                   <p className="text-sm text-gray-500 mt-1">
                     {archives.length === 0 
                       ? 'Anda belum menyimpan anotasi apapun.' 
                       : `Tidak ada dokumen dengan tipe "${filterType}" di arsip Anda.`}
                   </p>
                 </div>
              ) : (
                archives.filter(item => filterType === 'Semua' || item.type === filterType).map(item => (
                  <div key={item.id} className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow flex flex-col">
                    <div className="p-5 flex-1">
                      <div className="flex justify-between items-start mb-3">
                        <span className="px-2.5 py-1 bg-indigo-50 text-indigo-700 text-xs font-semibold rounded">
                          {item.type}
                        </span>
                        <span className="text-xs text-gray-400">
                          {item.createdAt?.toDate().toLocaleDateString('id-ID')}
                        </span>
                      </div>
                      
                      <h3 className="font-bold text-gray-900 mb-1 line-clamp-2" title={item.data.judulArtikel || item.data.judulBuku || item.data.judulChapter}>
                        {item.data.judulArtikel || item.data.judulBuku || item.data.judulChapter || 'Tanpa Judul'}
                      </h3>
                      <p className="text-sm text-gray-600 mb-4 line-clamp-1">
                        Oleh: {item.data.namaPenulis || 'Tidak diketahui'}
                      </p>
                      
                      <div className="flex items-center gap-1.5 text-xs text-blue-600 bg-blue-50 p-2 rounded border border-blue-100">
                        <File size={14} />
                        <span className="truncate" title={item.fileName}>{item.fileName}</span>
                      </div>
                    </div>
                    
                    <button 
                      onClick={() => {
                        setSelectedArchive(item);
                        setIsEditingArchive(false);
                        setEditedArchiveData(item.data);
                      }}
                      className="bg-gray-50 p-3 text-sm font-medium text-gray-700 hover:text-indigo-600 hover:bg-indigo-50 transition-colors border-t border-gray-200 flex justify-center items-center gap-1"
                    >
                      Lihat Detail Anotasi <ChevronRight size={16} />
                    </button>
                  </div>
                ))
              )}
            </div>
          </div>
        )}

      </main>

      {}
      {selectedArchive && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-gray-900/50 backdrop-blur-sm overflow-y-auto">
          <div className="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col">
            
            <div className="flex justify-between items-center p-5 border-b border-gray-100 bg-gray-50 rounded-t-2xl">
              <div>
                <h3 className="font-bold text-lg text-gray-900 flex items-center gap-2">
                  <Bookmark className="text-indigo-600"/> Detail Anotasi
                </h3>
                <p className="text-xs text-gray-500 mt-1">Disimpan pada: {selectedArchive.createdAt?.toDate().toLocaleString('id-ID')}</p>
              </div>
              <div className="flex items-center gap-2">
                {!isEditingArchive ? (
                  <button 
                    onClick={() => setIsEditingArchive(true)}
                    className="px-4 py-1.5 bg-indigo-100 text-indigo-700 hover:bg-indigo-200 rounded-md text-sm font-semibold transition-colors"
                  >
                    Edit Anotasi
                  </button>
                ) : (
                  <button 
                    onClick={() => { setIsEditingArchive(false); setEditedArchiveData(selectedArchive.data); }}
                    className="px-4 py-1.5 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-md text-sm font-semibold transition-colors"
                  >
                    Batal Edit
                  </button>
                )}
                <button 
                  onClick={() => { setSelectedArchive(null); resetAiState(); setIsEditingArchive(false); }}
                  className="p-2 text-gray-400 hover:bg-gray-200 hover:text-gray-800 rounded-full transition-colors"
                >
                  <X size={24} />
                </button>
              </div>
            </div>

            <div className="p-6 overflow-y-auto flex-1 custom-scrollbar">
              <div className="mb-6 flex justify-between items-center bg-blue-50 border border-blue-100 rounded-lg p-4">
                 <div>
                   <p className="text-xs font-bold text-blue-800 uppercase mb-1">File Dokumen Asli (Arsip)</p>
                   <p className="text-sm text-blue-900 flex items-center gap-2"><File size={16}/> {selectedArchive.fileName}</p>
                 </div>
              </div>

              {isEditingArchive ? (
                <div className="animate-in fade-in duration-300">
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4 mb-6">
                    {DISPLAY_ORDER[selectedArchive.type].map(key => 
                      renderField(key, editedArchiveData[key], true, (k, v) => setEditedArchiveData({...editedArchiveData, [k]: v}))
                    )}
                  </div>
                  <div className="flex justify-end pt-4 border-t border-gray-200">
                    <button 
                      onClick={handleUpdateArchive}
                      disabled={isProcessing}
                      className="bg-indigo-600 text-white px-6 py-2.5 rounded-lg font-semibold shadow-sm hover:bg-indigo-700 transition-all flex items-center gap-2 disabled:bg-indigo-400"
                    >
                      {isProcessing ? <Loader2 size={18} className="animate-spin" /> : <Save size={18} />}
                      {isProcessing ? 'Menyimpan...' : 'Simpan Perubahan'}
                    </button>
                  </div>
                </div>
              ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4 animate-in fade-in duration-300">
                   {DISPLAY_ORDER[selectedArchive.type].map(key => 
                      renderField(key, selectedArchive.data[key], false)
                   )}
                </div>
              )}
              
              {!isEditingArchive && (
                <div className="mt-8 border-t border-gray-200 pt-2">
                  {renderAiAssistant(selectedArchive.data)}
                </div>
              )}
            </div>
            
          </div>
        </div>
      )}

      {}
      <footer className="bg-white border-t border-gray-200 py-4 mt-auto">
        <div className="max-w-6xl mx-auto px-4 text-center text-sm text-gray-500">
          &copy; 2026 Aplikasi Anotasi Bibliografi. Dibangun untuk mempermudah riset Anda.
        </div>
      </footer>

      <style dangerouslySetInnerHTML={{__html: `
        .custom-scrollbar::-webkit-scrollbar {
          width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
          background: #f1f1f1; 
          border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
          background: #c1c1c1; 
          border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
          background: #a8a8a8; 
        }
      `}} />
    </div>
  );
}
